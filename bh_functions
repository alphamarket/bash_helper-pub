#!/bin/bash

# replace `$2` with `$3` in directory `$1`
function str_replace
{
    grep -rlE "$2" "$1" | xargs sed -i.bak "s/$2/$3/g"
}

function str_find
{
    pattern="$2"
    directory="$1"
    grep -nE $pattern -r $directory ${@:3}
}
# gen random passwords
function genpasswd() {
	local l=$1
   	[ "$l" == "" ] && l=16
	tr -dc 'A-Za-z0-9_~!@#$^&*().,/;:[]{}\|-' < /dev/urandom | head -c ${l}
}
function genpasswd2() {
	local l=$1
   	[ "$l" == "" ] && l=16
	tr -dc 'A-Za-z0-9_-' < /dev/urandom | head -c ${l}
}
# up/down grid of a process by name
function niceproc()
{
    echo -e "\e[33m\c"
    sudo renice -n $2 -p `ps -A | grep $1 | cut -d '?' -f1`
    echo -e "\e[m\c"
}
# check if file exists
function e()
{
    while test $# -gt 0; do
        if [ -e "$1" ]; then
            echo -e "\e[32m[ YES ] $1\e[39m";
        else
            echo -e "\e[31m[ NOP ] $1\e[39m";
        fi
        shift;
    done
}
# check if a passed command has output
function has_output()
{
    echo $($* 2> /dev/null | wc -l)
}

function count_code_line()
{
    cat ${*:2} | sed "/^\s*$1/d;/^\s*$/d" | wc -l
}

function videos2mp3() {
	shopt -s nocasematch
    for file in ./*.*; do
        # Check if the file is a video file by its extension
        if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
            # Extract the file name without the extension
            filename_without_extension=$(basename -- "$file")
            filename_without_extension="${filename_without_extension%.*}"
            # Extract subtitles from the original file
            ffmpeg -i "$file" -vn -ab 192k -ar 44100 "./$filename_without_extension.mp3"
        fi
    done
}

function videos2mp4() {
	shopt -s nocasematch
	for file in ./*.*; do
	    # Check if the file is a video file by its extension
	    if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
	        # Extract the file name without the extension
	        filename_without_extension=$(basename -- "$file")
	        filename_without_extension="${filename_without_extension%.*}"
	        # Convert the video to mp4 using ffmpeg
	        ffmpeg -i "$file" $* "./$filename_without_extension.mp4"
	    fi
	done
}

function videos2sub() {
	shopt -s nocasematch
    for file in ./*.*; do
        # Check if the file is a video file by its extension
        if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
            # Extract the file name without the extension
            filename_without_extension=$(basename -- "$file")
            filename_without_extension="${filename_without_extension%.*}"
            # Extract subtitles from the original file
            ffmpeg -i "$file" -map 0:s:0 "./$filename_without_extension.srt"
        fi
    done
}

function t() {
	(
		xfce4-terminal --working-directory="$(pwd)" 2>/dev/null || \
		gnome-terminal --working-directory="$(pwd)" 2>/dev/null || \
	 	konsole --workdir "$(pwd)" 2>/dev/null || \
	 	mate-terminal --working-directory="$(pwd)" 2>/dev/null || \
	 	lxterminal --working-directory="$(pwd)" 2>/dev/null || \
	 	x-terminal-emulator --working-directory="$(pwd)" 2>/dev/null
 	)&
}

# dl <url> [aria2c options] — download with aria2c, faster on servers that
# throttle each connection. aria2c allows at most 16 connections per host, so
# when an http(s) link redirects to another host (download mirrors, CDNs) the
# file is fetched from both at once: up to 32 connections. The redirect target
# is used only if aria2c can reach it and it serves the same file (same size).
# If that download fails, it falls back to the plain `aria2c -c -x 16 -s 16`.
# Magnet, .torrent, ftp or several links run the plain command directly.
# Resumes from an existing `.aria2` file — stop the old download first.
unalias dl 2>/dev/null   # the old `alias dl=aria2c…` would shadow this function
function dl() {
	local url="$1" a final size rc
	local -a uris extra=()
	if ! command -v aria2c >/dev/null; then
		echo -e "\e[31mdl needs aria2c, which is not installed — run: sudo apt install aria2\e[m" >&2
		return 1
	fi
	if [ -z "$url" ]; then
		echo "usage: dl <url> [aria2c options]" >&2
		return 1
	fi
	for a in "${@:2}"; do [[ $a == -* ]] || extra+=("$a"); done
	if [[ ! $url =~ ^https?:// ]] || [ ${#extra[@]} -gt 0 ] || ! command -v curl >/dev/null; then
		aria2c -c -x 16 -s 16 "$@"
		return
	fi
	if pgrep -ax aria2c | grep -qF -- "${url%%\?*}"; then
		echo -e "\e[33maria2c is already downloading this link — press Ctrl-C in that terminal first.\e[m" >&2
		return 1
	fi
	uris=("$url")
	# file size from a 1-byte range request: "<code> <url_effective> <size>"
	read -r a final size < <(curl -sL -o /dev/null -m 15 -r 0-0 -D - -w '%{http_code} %{url_effective}\n' "$url" \
		| tr -d '\r' | awk -F/ 'tolower($0) ~ /^content-range:/{s=$NF} /^[0-9]+ /{l=$0} END{print l, s}')
	if [ "$a" = 206 ] && [[ $size =~ ^[0-9]+$ ]] \
		&& [ "$(sed -E 's#^[a-zA-Z]+://([^/]+).*#\1#' <<<"$final")" != "$(sed -E 's#^[a-zA-Z]+://([^/]+).*#\1#' <<<"$url")" ] \
		&& [ "$(curl -s -o /dev/null -m 15 -r 0-0 -D - "$final" | tr -d '\r' | awk -F/ 'tolower($0) ~ /^content-range:/{print $NF}')" = "$size" ] \
		&& aria2c -q --dry-run=true --max-tries=1 --connect-timeout=10 -d /tmp -o ".dl-probe-$$" "$final" 2>/dev/null; then
		uris+=("$final")
	fi
	echo "Sources: ${#uris[@]} (up to $(( ${#uris[@]} * 16 )) connections)"
	aria2c -c -x 16 -s $(( ${#uris[@]} * 16 )) -k 1M --summary-interval=60 "${@:2}" "${uris[@]}"
	rc=$?
	# 7 = stopped with Ctrl-C (unfinished): respect it, no fallback
	if [ $rc -ne 0 ] && [ $rc -ne 7 ] && [ ${#uris[@]} -gt 1 ]; then
		echo -e "\e[33mFast download failed (aria2c exit $rc) — retrying with the plain 16-connection download…\e[m" >&2
		aria2c -c -x 16 -s 16 "${@:2}" "$url"
		rc=$?
	fi
	return $rc
}
