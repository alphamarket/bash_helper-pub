#!/bin/bash

# replace `$2` with `$3` in directory `$1`
function str_replace
{
    grep -rlE "$2" "$1" | xargs sed -i.bak "s/$2/$3/g"
}

function str_find
{
    pattern="$2"
    directory="$1"
    grep -nE $pattern -r $directory ${@:3}
}
# gen random passwords
function genpasswd() {
	local l=$1
   	[ "$l" == "" ] && l=16
	tr -dc 'A-Za-z0-9_~!@#$^&*().,/;:[]{}\|-' < /dev/urandom | head -c ${l}
}
function genpasswd2() {
	local l=$1
   	[ "$l" == "" ] && l=16
	tr -dc 'A-Za-z0-9_-' < /dev/urandom | head -c ${l}
}
# up/down grid of a process by name
function niceproc()
{
    echo -e "\e[33m\c"
    sudo renice -n $2 -p `ps -A | grep $1 | cut -d '?' -f1`
    echo -e "\e[m\c"
}
# check if file exists
function e()
{
    while test $# -gt 0; do
        if [ -e "$1" ]; then
            echo -e "\e[32m[ YES ] $1\e[39m";
        else
            echo -e "\e[31m[ NOP ] $1\e[39m";
        fi
        shift;
    done
}
# check if a passed command has output
function has_output()
{
    echo $($* 2> /dev/null | wc -l)
}

function count_code_line()
{
    cat ${*:2} | sed "/^\s*$1/d;/^\s*$/d" | wc -l
}

function videos2mp3() {
	shopt -s nocasematch
    for file in ./*.*; do
        # Check if the file is a video file by its extension
        if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
            # Extract the file name without the extension
            filename_without_extension=$(basename -- "$file")
            filename_without_extension="${filename_without_extension%.*}"
            # Extract subtitles from the original file
            ffmpeg -i "$file" -vn -ab 192k -ar 44100 "./$filename_without_extension.mp3"
        fi
    done
}

function videos2mp4() {
	shopt -s nocasematch
	for file in ./*.*; do
	    # Check if the file is a video file by its extension
	    if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
	        # Extract the file name without the extension
	        filename_without_extension=$(basename -- "$file")
	        filename_without_extension="${filename_without_extension%.*}"
	        # Convert the video to mp4 using ffmpeg
	        ffmpeg -i "$file" $* "./$filename_without_extension.mp4"
	    fi
	done
}

function videos2sub() {
	shopt -s nocasematch
    for file in ./*.*; do
        # Check if the file is a video file by its extension
        if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
            # Extract the file name without the extension
            filename_without_extension=$(basename -- "$file")
            filename_without_extension="${filename_without_extension%.*}"
            # Extract subtitles from the original file
            ffmpeg -i "$file" -map 0:s:0 "./$filename_without_extension.srt"
        fi
    done
}

function t() {
	(
		xfce4-terminal --working-directory="$(pwd)" 2>/dev/null || \
		gnome-terminal --working-directory="$(pwd)" 2>/dev/null || \
	 	konsole --workdir "$(pwd)" 2>/dev/null || \
	 	mate-terminal --working-directory="$(pwd)" 2>/dev/null || \
	 	lxterminal --working-directory="$(pwd)" 2>/dev/null || \
	 	x-terminal-emulator --working-directory="$(pwd)" 2>/dev/null
 	)&
}

# dl <url> [-d dir] [-o name] [aria2c options] — fast, resumable download.
# http(s) links go through bh_dl.py: it starts at 16 connections, doubles them
# every few seconds while the total speed keeps rising (up to 128), settles on
# the best count and re-checks it every minute — servers that throttle each
# connection download several times faster than with aria2c's 16. Progress is
# a real `.aria2` file, so dl and aria2c resume each other's downloads; Ctrl-C
# once stops cleanly, twice stops at once, run the same command to resume.
# Everything bh_dl.py does not handle (magnet, .torrent, ftp, several links,
# other aria2c options, servers without ranges) runs `aria2c -c -x 16 -s 16`,
# and so does a download that fails mid-way (it resumes from the .aria2 file).
unalias dl 2>/dev/null   # the old `alias dl=aria2c…` would shadow this function
function dl() {
	local rc
	if ! command -v aria2c >/dev/null; then
		echo -e "\e[31mdl needs aria2c, which is not installed — run: sudo apt install aria2\e[m" >&2
		return 1
	fi
	if [ $# -eq 0 ]; then
		echo "usage: dl <url> [-d dir] [-o name] [aria2c options]" >&2
		return 1
	fi
	if pgrep -ax aria2c | grep -qF -- "${1%%\?*}" || pgrep -a python3 | grep -F bh_dl.py | grep -qF -- "${1%%\?*}"; then
		echo -e "\e[33mThis link is already downloading — press Ctrl-C in that terminal first.\e[m" >&2
		return 1
	fi
	if command -v python3 >/dev/null; then
		python3 -I "${BASE_DIR:-$HOME/.bash_helper.d}/bh_dl.py" "$@"
		rc=$?
		case $rc in
			0|7) return $rc ;;   # done / stopped with Ctrl-C (resumable)
			3) ;;                # not for bh_dl.py: plain aria2c below
			*) echo -e "\e[33mFast download failed (exit $rc) — continuing with aria2c…\e[m" >&2 ;;
		esac
	fi
	aria2c -c -x 16 -s 16 "$@"
}
