#!/bin/bash

# replace `$2` with `$3` in directory `$1`
function str_replace
{
    grep -rlE "$2" "$1" | xargs sed -i.bak "s/$2/$3/g"
}

function str_find
{
    pattern="$2"
    directory="$1"
    grep -nE $pattern -r $directory ${@:3}
}
# gen random passwords
function genpasswd() {
	local l=$1
   	[ "$l" == "" ] && l=16
	tr -dc 'A-Za-z0-9_~!@#$^&*().,/;:[]{}\|-' < /dev/urandom | head -c ${l}
}
function genpasswd2() {
	local l=$1
   	[ "$l" == "" ] && l=16
	tr -dc 'A-Za-z0-9_-' < /dev/urandom | head -c ${l}
}
# up/down grid of a process by name
function niceproc()
{
    echo -e "\e[33m\c"
    sudo renice -n $2 -p `ps -A | grep $1 | cut -d '?' -f1`
    echo -e "\e[m\c"
}
# check if file exists
function e()
{
    while test $# -gt 0; do
        if [ -e "$1" ]; then
            echo -e "\e[32m[ YES ] $1\e[39m";
        else
            echo -e "\e[31m[ NOP ] $1\e[39m";
        fi
        shift;
    done
}
# check if a passed command has output
function has_output()
{
    echo $($* 2> /dev/null | wc -l)
}

function count_code_line()
{
    cat ${*:2} | sed "/^\s*$1/d;/^\s*$/d" | wc -l
}

function videos2mp3() {
	shopt -s nocasematch
    for file in ./*.*; do
        # Check if the file is a video file by its extension
        if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
            # Extract the file name without the extension
            filename_without_extension=$(basename -- "$file")
            filename_without_extension="${filename_without_extension%.*}"
            # Extract subtitles from the original file
            ffmpeg -i "$file" -vn -ab 192k -ar 44100 "./$filename_without_extension.mp3"
        fi
    done
}

function videos2mp4() {
	shopt -s nocasematch
	for file in ./*.*; do
	    # Check if the file is a video file by its extension
	    if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
	        # Extract the file name without the extension
	        filename_without_extension=$(basename -- "$file")
	        filename_without_extension="${filename_without_extension%.*}"
	        # Convert the video to mp4 using ffmpeg
	        ffmpeg -i "$file" $* "./$filename_without_extension.mp4"
	    fi
	done
}

function videos2sub() {
	shopt -s nocasematch
    for file in ./*.*; do
        # Check if the file is a video file by its extension
        if [[ -f "$file" && "$file" =~ \.(avi|mkv|mov|wmv|flv|mpg|mpeg|mp4|webm)$ ]]; then
            # Extract the file name without the extension
            filename_without_extension=$(basename -- "$file")
            filename_without_extension="${filename_without_extension%.*}"
            # Extract subtitles from the original file
            ffmpeg -i "$file" -map 0:s:0 "./$filename_without_extension.srt"
        fi
    done
}

function t() {
	(
		xfce4-terminal --working-directory="$(pwd)" 2>/dev/null || \
		gnome-terminal --working-directory="$(pwd)" 2>/dev/null || \
	 	konsole --workdir "$(pwd)" 2>/dev/null || \
	 	mate-terminal --working-directory="$(pwd)" 2>/dev/null || \
	 	lxterminal --working-directory="$(pwd)" 2>/dev/null || \
	 	x-terminal-emulator --working-directory="$(pwd)" 2>/dev/null
 	)&
}

# dlfast <url> — like `dl`, but up to 64 connections instead of 16, for servers
# that throttle each connection. aria2c caps connections per host name, so the
# same file is offered under several spellings of its host: the original link,
# the URL it redirects to, and each with a trailing dot (`host.`, the same
# server). Resumes from an existing `<file>.aria2` in the current directory —
# stop the old download with Ctrl-C first.
function dlfast() {
	local url="$1" name final u host
	local -a uris=()
	if [ -z "$url" ]; then
		echo "usage: dlfast <url>" >&2
		return 1
	fi
	name=$(basename -- "${url%%\?*}")
	name=$(printf '%b' "${name//%/\\x}")
	if pgrep -ax aria2c | grep -qF -- "$name"; then
		echo -e "\e[33maria2c is already downloading \`$name\` — press Ctrl-C in that terminal first.\e[m" >&2
		return 1
	fi
	final=$(curl -s -o /dev/null -m 15 -L -r 0-0 -w '%{url_effective}' "$url")
	for u in "$url" ${final:+"$final"}; do
		host=$(sed -E 's#^[a-zA-Z]+://([^/:]+).*#\1#' <<<"$u")
		uris+=("$u" "${u/$host/$host.}")
	done
	mapfile -t uris < <(printf '%s\n' "${uris[@]}" | awk '!seen[$0]++')
	echo "File: $name"
	echo "Sources: ${#uris[@]} (up to $(( ${#uris[@]} * 16 )) connections)"
	[ -f "$name.aria2" ] && echo "Resuming from $name.aria2"
	aria2c -c -o "$name" -x 16 -s $(( ${#uris[@]} * 16 )) -k 1M \
		--file-allocation=none --summary-interval=60 "${uris[@]}"
}
