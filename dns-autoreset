#!/bin/bash
# Re-pin every NetworkManager connection's DNS to the boot mode.
#
# Run once per login by the dns-autoreset.service user unit, so each boot
# starts on DNS_BOOT_MODE (default: $DNS_DEFAULT_SERVERS, i.e. 1.1.1.1 +
# 8.8.8.8; "auto" = DHCP) regardless of what dns-proxy left in the saved
# profiles. dns-proxy / dns-default / dns-auto switch again within the session.

command -v nmcli >/dev/null 2>&1 || exit 0
. "${BASH_SOURCE[0]%/*}/bh_dns" || exit 0
__dns_boot_reset >/dev/null 2>&1
exit 0
