#!/bin/bash
# DNS switching for systemd-resolved + NetworkManager machines.
#
# Writing /etc/resolv.conf directly does NOT stick here: it is a symlink to
# systemd-resolved's runtime stub, which resolved rewrites on every network
# event. Setting the DNS on the active NM connection (ignore-auto-dns) makes
# NM re-push our servers into resolved on every (re)connect, so the choice
# holds across reconnects / Wi-Fi off-on within a session.
#
# By design the choice does NOT survive a reboot: a per-user `dns-autoreset`
# service (installed lazily the first time you switch DNS) clears all DNS
# overrides back to automatic at each login, so every boot starts on DHCP DNS
# until you run dns-proxy again. The Shecan keepalive is likewise ephemeral
# (a transient user timer in /run). Net effect: full, explicit control —
# nothing DNS-related lingers past a reboot.
#
# nmcli/resolvectl run without sudo because polkit grants the active local user
# settings.modify.system (verify with `nmcli general permissions`).
#
# Customize without editing this file — set any of these in ~/.bash_helper.d/
# bh_dns.local (gitignored) or the environment:
#   DNS_PROXY_SERVERS    resolvers for dns-proxy   (default: Shecan)
#   DNS_DEFAULT_SERVERS  resolvers for dns-default (default: Cloudflare+Google)
#   SHECAN_DDNS_URL      your private Shecan keepalive URL (use dns-keepalive-setup)
SHECAN_DDNS_UNIT='shecan-ddns'
__bh_dns_local="${BASH_SOURCE[0]%/*}/bh_dns.local"
[ -r "$__bh_dns_local" ] && . "$__bh_dns_local"
unset __bh_dns_local
: "${DNS_PROXY_SERVERS:=178.22.122.101 185.51.200.1}"
: "${DNS_DEFAULT_SERVERS:=1.1.1.1 8.8.8.8}"
SHECAN_DDNS_URL="${SHECAN_DDNS_URL:-}"

# ---- console output helpers (consistent, professional formatting) ----------
__dns_head() { printf '\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$1"; }
__dns_ok()   { printf '\033[1;32m==>\033[0m %s\n' "$1"; }
__dns_warn() { printf '\033[1;33m==>\033[0m %s\n' "$1" >&2; }
__dns_err()  { printf '\033[1;31m==>\033[0m %s\n' "$1" >&2; }
__dns_kv()   { printf '    \033[2m%-10s\033[0m %s\n' "$1" "$2"; }

# Name of the NM connection backing the current default route.
__dns_active_conn() {
	local dev conn
	dev=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
	[ -z "$dev" ] && return 1
	conn=$(nmcli -t -f GENERAL.CONNECTION device show "$dev" 2>/dev/null | cut -d: -f2-)
	[ -z "$conn" ] && return 1
	printf '%s' "$conn"
}

# Lazily install + enable the boot-time DNS auto-reset, exactly once. Called
# only from dns-change, so it never gets set up for users who don't switch DNS.
__dns_ensure_autoreset() {
	command -v systemctl >/dev/null 2>&1 || return 0
	systemctl --user is-enabled dns-autoreset.service >/dev/null 2>&1 && return 0

	local dir src dst
	dir="${BASH_SOURCE[0]%/*}"
	src="$dir/dns-autoreset.service"
	[ -r "$src" ] || return 0
	dst="$HOME/.config/systemd/user"
	mkdir -p "$dst"
	cp -f "$src" "$dst/dns-autoreset.service"
	[ -f "$dir/dns-autoreset" ] && chmod +x "$dir/dns-autoreset"
	systemctl --user daemon-reload >/dev/null 2>&1
	if systemctl --user enable dns-autoreset.service >/dev/null 2>&1; then
		__dns_ok "Boot reset installed — DNS returns to automatic on each login"
	else
		__dns_warn "Could not enable boot DNS auto-reset service"
	fi
}

# Reapply the active connection (no Wi-Fi drop) and flush the resolver cache.
__dns_apply() {
	local dev conn
	dev=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
	conn=$(__dns_active_conn)
	nmcli device reapply "$dev" >/dev/null 2>&1 \
		|| nmcli connection up "$conn" >/dev/null 2>&1
	resolvectl flush-caches >/dev/null 2>&1
}

# Connection + configured resolvers (consistent across every command).
__dns_show() {
	local dev conn servers
	dev=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
	conn=$(__dns_active_conn)
	servers=$(resolvectl status "$dev" 2>/dev/null | sed -n 's/.*DNS Servers: //p' | head -1)
	[ -z "$servers" ] && servers=$(resolvectl status "$dev" 2>/dev/null | sed -n 's/.*Current DNS Server: //p' | head -1)
	__dns_kv "Connection" "${conn:-?}"
	printf '    \033[2m%-10s\033[0m \033[36m%s\033[0m\n' "Servers" "${servers:-none}"
	return 0
}

# Start the ephemeral Shecan DDNS keepalive (runs as the user, not root).
__shecan_ddns_start() {
	if [ -z "$SHECAN_DDNS_URL" ]; then
		__dns_warn "Keepalive off — run 'dns-keepalive-setup' to store your Shecan password."
		return 0
	fi
	if ! command -v systemd-run >/dev/null 2>&1; then
		__dns_warn "systemd-run not found — Shecan keepalive skipped."
		return 1
	fi
	# Clear any previous instance and WAIT for systemd to garbage-collect it —
	# reusing the same --unit name before the old transient unit is gone fails
	# with "unit already exists".
	local t="${SHECAN_DDNS_UNIT}.timer" s="${SHECAN_DDNS_UNIT}.service" i
	systemctl --user stop "$t" "$s" >/dev/null 2>&1
	systemctl --user reset-failed "$t" "$s" >/dev/null 2>&1
	for ((i = 0; i < 30; i++)); do
		[ "$(systemctl --user show -p LoadState --value "$t" 2>/dev/null)" = "not-found" ] &&
			[ "$(systemctl --user show -p LoadState --value "$s" 2>/dev/null)" = "not-found" ] && break
		sleep 0.1
	done

	local err
	if err=$(systemd-run --user --unit="$SHECAN_DDNS_UNIT" \
		--on-calendar='*:0/5' --timer-property=AccuracySec=30s \
		curl -fsS --max-time 20 "$SHECAN_DDNS_URL" 2>&1 >/dev/null); then
		( curl -fsS --max-time 20 "$SHECAN_DDNS_URL" >/dev/null 2>&1 & )  # register now, no job noise
		__dns_ok "Keepalive started — pings Shecan every 5 min (clears on reboot)"
	else
		__dns_warn "Could not start Shecan keepalive: ${err:-unknown error}"
	fi
}

# Stop and remove the keepalive timer (no-op if not running).
__shecan_ddns_stop() {
	if systemctl --user list-units --all 2>/dev/null | grep -q "${SHECAN_DDNS_UNIT}.timer"; then
		systemctl --user stop "${SHECAN_DDNS_UNIT}.timer" >/dev/null 2>&1
		systemctl --user reset-failed "${SHECAN_DDNS_UNIT}.service" "${SHECAN_DDNS_UNIT}.timer" >/dev/null 2>&1
		__dns_ok "Keepalive stopped"
	fi
}

# dns-change <server1> [server2 ...] — pin these resolvers for the session.
dns-change() {
	if ! command -v nmcli >/dev/null 2>&1; then
		__dns_err "NetworkManager (nmcli) not found — cannot set DNS."
		return 1
	fi
	if [ "$#" -eq 0 ]; then
		__dns_err "Usage: dns-change <dns1> [dns2 ...]"
		return 1
	fi

	local conn
	conn=$(__dns_active_conn) || {
		__dns_err "No active network connection found."
		return 1
	}

	__dns_head "Setting DNS on $conn"
	# ipv6 cleared + ignored so AAAA lookups don't leak past these resolvers.
	if ! nmcli connection modify "$conn" \
		ipv4.ignore-auto-dns yes ipv4.dns "$*" \
		ipv6.ignore-auto-dns yes ipv6.dns ""; then
		__dns_err "Failed to update connection settings."
		return 1
	fi
	__dns_apply
	__dns_ensure_autoreset
	__dns_ok "DNS applied — holds until reboot or dns-default/dns-auto"
	return 0
}

# dns-proxy — anti-sanction resolvers ($DNS_PROXY_SERVERS) + DDNS keepalive.
dns-proxy() {
	dns-change $DNS_PROXY_SERVERS || return 1
	__shecan_ddns_start
	dns-status
}

# dns-default — public resolvers ($DNS_DEFAULT_SERVERS); stops Shecan keepalive.
dns-default() {
	__shecan_ddns_stop
	dns-change $DNS_DEFAULT_SERVERS || return 1
	dns-status
}

# dns-auto — hand DNS back to the network (DHCP); stops Shecan keepalive.
dns-auto() {
	__shecan_ddns_stop
	local conn
	conn=$(__dns_active_conn) || {
		__dns_err "No active network connection found."
		return 1
	}
	__dns_head "Restoring automatic DNS on $conn"
	if ! nmcli connection modify "$conn" \
		ipv4.ignore-auto-dns no ipv4.dns "" \
		ipv6.ignore-auto-dns no ipv6.dns ""; then
		__dns_err "Failed to update connection settings."
		return 1
	fi
	__dns_apply
	__dns_ok "DNS restored to network defaults (DHCP)"
	dns-status
	return 0
}

# dns-status — current resolvers, active server, and Shecan keepalive state.
dns-status() {
	local dev current
	__dns_head "DNS status"
	__dns_show
	dev=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
	current=$(resolvectl status "$dev" 2>/dev/null | sed -n 's/.*Current DNS Server: //p' | head -1)
	[ -n "$current" ] && __dns_kv "Active" "$current"
	if systemctl --user is-active "${SHECAN_DDNS_UNIT}.timer" >/dev/null 2>&1; then
		printf '    \033[2m%-10s\033[0m \033[32m%s\033[0m\n' "Keepalive" "active"
	else
		printf '    \033[2m%-10s\033[0m \033[90m%s\033[0m\n' "Keepalive" "inactive"
	fi
	if systemctl --user is-enabled dns-autoreset.service >/dev/null 2>&1; then
		printf '    \033[2m%-10s\033[0m \033[32m%s\033[0m\n' "Boot reset" "enabled"
	else
		printf '    \033[2m%-10s\033[0m \033[90m%s\033[0m\n' "Boot reset" "not set up"
	fi
}

# dns-help — list the available DNS commands and current configured resolvers.
dns-help() {
	local fmt='    \033[36m%-22s\033[0m %s\n'
	__dns_head "DNS commands"
	printf "$fmt" "dns-proxy"            "switch to proxy resolvers + start keepalive"
	printf "$fmt" "dns-default"          "switch to public resolvers"
	printf "$fmt" "dns-auto"             "restore automatic DNS (DHCP)"
	printf "$fmt" "dns-change <ip...>"   "set arbitrary resolvers for this session"
	printf "$fmt" "dns-status"           "show current resolvers + keepalive state"
	printf "$fmt" "dns-proxy-ip-setup"   "set the resolvers used by dns-proxy"
	printf "$fmt" "dns-default-ip-setup" "set the resolvers used by dns-default"
	printf "$fmt" "dns-keepalive-setup"  "store your private Shecan keepalive password"
	printf "$fmt" "dns-uninstall"        "clean teardown of all DNS tooling state"
	printf "$fmt" "dns-help"             "show this help"
	__dns_head "Configured resolvers (set via the *-ip-setup commands)"
	__dns_kv "proxy"   "${DNS_PROXY_SERVERS}"
	__dns_kv "default" "${DNS_DEFAULT_SERVERS}"
}

# Upsert a KEY='value' line into bh_dns.local, preserving any other settings.
__dns_local_set() {
	local key="$1" val="$2" file
	file="${BASH_SOURCE[0]%/*}/bh_dns.local"
	[ -f "$file" ] || echo "# Local, untracked DNS config (gitignored)." > "$file"
	sed -i "/^${key}=/d" "$file" 2>/dev/null
	printf "%s='%s'\n" "$key" "$val" >> "$file"
	chmod 600 "$file"
}

# dns-keepalive-setup [password] — store YOUR (private) Shecan DDNS password in
# ~/.bash_helper.d/bh_dns.local (gitignored). Each user sets their own key.
dns-keepalive-setup() {
	local pass
	pass="$1"
	if [ -z "$pass" ]; then
		printf 'Shecan DDNS password%s: ' "$([ -n "$SHECAN_DDNS_URL" ] && echo ' (empty = keep current)')"
		read -r pass
		if [ -z "$pass" ] && [ -n "$SHECAN_DDNS_URL" ]; then
			__dns_ok "Kept existing keepalive config."
			return 0
		fi
	fi
	if [ -z "$pass" ]; then
		__dns_err "No password entered — aborted."
		return 1
	fi
	SHECAN_DDNS_URL="https://ddns.shecan.ir/update?password=${pass}"
	__dns_local_set "SHECAN_DDNS_URL" "$SHECAN_DDNS_URL"
	__dns_ok "Saved keepalive config to ~/.bash_helper.d/bh_dns.local"
	__dns_ok "Run 'dns-proxy' to start using it."
}

# dns-proxy-ip-setup [ip...] — set the resolvers dns-proxy uses (persisted).
dns-proxy-ip-setup() {
	local ips
	if [ "$#" -gt 0 ]; then
		ips="$*"
	else
		printf 'Proxy DNS server IP(s) [%s]: ' "$DNS_PROXY_SERVERS"
		read -r ips
		[ -z "$ips" ] && ips="$DNS_PROXY_SERVERS"
	fi
	if [ -z "$ips" ]; then
		__dns_err "No IPs entered — aborted."
		return 1
	fi
	DNS_PROXY_SERVERS="$ips"
	__dns_local_set "DNS_PROXY_SERVERS" "$ips"
	__dns_ok "dns-proxy will use: $ips"
}

# dns-default-ip-setup [ip...] — set the resolvers dns-default uses (persisted).
dns-default-ip-setup() {
	local ips
	if [ "$#" -gt 0 ]; then
		ips="$*"
	else
		printf 'Default DNS server IP(s) [%s]: ' "$DNS_DEFAULT_SERVERS"
		read -r ips
		[ -z "$ips" ] && ips="$DNS_DEFAULT_SERVERS"
	fi
	if [ -z "$ips" ]; then
		__dns_err "No IPs entered — aborted."
		return 1
	fi
	DNS_DEFAULT_SERVERS="$ips"
	__dns_local_set "DNS_DEFAULT_SERVERS" "$ips"
	__dns_ok "dns-default will use: $ips"
}

# dns-uninstall — clean teardown: stop keepalive, remove the boot auto-reset
# service, and restore automatic DNS. Leaves the commands and your password file.
dns-uninstall() {
	__dns_head "Removing DNS tooling state"
	__shecan_ddns_stop
	if command -v systemctl >/dev/null 2>&1; then
		systemctl --user disable --now dns-autoreset.service >/dev/null 2>&1
		rm -f "$HOME/.config/systemd/user/dns-autoreset.service"
		systemctl --user daemon-reload >/dev/null 2>&1
		systemctl --user reset-failed dns-autoreset.service >/dev/null 2>&1
		__dns_ok "Boot DNS auto-reset disabled and removed"
	fi
	local conn
	if conn=$(__dns_active_conn); then
		nmcli connection modify "$conn" \
			ipv4.ignore-auto-dns no ipv4.dns "" \
			ipv6.ignore-auto-dns no ipv6.dns "" >/dev/null 2>&1
		__dns_apply
		__dns_ok "DNS restored to automatic (DHCP)"
	fi
	__dns_ok "Clean — commands stay; your password file (bh_dns.local) was kept"
}
