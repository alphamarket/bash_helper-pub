#!/bin/bash

# level#1 aliases
alias push='_git_smart push'
alias co='git checkout $*'
alias tags='git describe'
alias tag='git tag -l -n1 $*'
alias merge='git merge $*'
alias pull='git pull $*'
alias stash='git stash $*'
alias add='git add $*'
alias commit='git commit $*'
alias pall='_git_smart push; _git_smart push --tags'
alias stash='git stash $*'
alias branch='git branch $*'
alias clone='git clone $*'
alias log='git log --graph --decorate --pretty=format:"%C(yellow)%h%Creset %C(green)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit --decorate --date-order --color $*'
alias status='_git_smart status'
alias rmt='find . -name "*~" -print0 | xargs -0 rm -vrf'

# level#2 aliases
alias mp='git checkout main && git merge develop --no-edit && git checkout develop'
alias d='git checkout develop'
alias m='git checkout main'
alias mm='git checkout master'
alias p='_git_smart push'
alias pt='_git_smart push --tags'
alias a='git add -A :/'
alias c='git commit -qam $*'
alias s='_git_smart status'
alias diff='_git_smart diff'
alias show='_git_smart show'
alias ap='git commit -qa --amend && _git_smart push -f'
alias l='log | head -n 5'
alias b='git branch $*'
